    "activityBar.background": "{component.navigation.background}",
    "tab.activeBackground": "{component.tab.active-background}",
    "tab.activeForeground": "{component.tab.active-foreground}",
    "tab.border": "{component.tab.border}",
    "tab.hoverBackground": "{component.tab.hover-background}",
    "tab.unfocusedHoverBackground": "{component.tab.hover-background}",
    "tab.inactiveBackground": "{component.tab.inactive-background}",
    "sideBar.background": "{component.sidebar.background}",
