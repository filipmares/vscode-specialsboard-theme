    "list.inactiveSelectionBackground": "{component.list.inactive-background}",
    "terminal.foreground": "{component.console.foreground}",
    "statusBar.background": "{component.status.background}",
    "statusBar.noFolderBackground": "{component.status.background}",
    "statusBar.foreground": "{component.status.foreground}",
    "statusBar.debuggingBackground": "{component.status.debug-background}",
    "statusBar.debuggingBorder": "{component.status.debug-border}",
    "statusBar.debuggingForeground": "{component.status.debug-foreground}",
    "statusBarItem.hoverBackground": "{component.status.hover-background}",
    "statusBarItem.remoteBackground": "{component.status.remote-background}",
    "statusBarItem.remoteForeground": "{component.status.remote-foreground}"
