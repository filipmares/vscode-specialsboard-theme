{
	"name": "theme-specialsboard",
	"displayName": "Specials Board",
	"description": "Specials Board - Inspired by the original Coda text editor theme",
	"icon": "icon.png",
	"version": "2.2.0",
	"publisher": "filipmares",
	"scripts": {
		"generate": "node scripts/generate.mjs",
		"check": "node scripts/generate.mjs --check",
		"test": "node --test",
		"vscode:prepublish": "npm run check",
		"package": "npm run check && npm test && vsce package --skip-license"
	},
	"devDependencies": {
		"@vscode/vsce": "3.9.2",
		"ajv": "8.20.0",
		"shiki": "4.4.3"
	},
	"engines": {
		"vscode": "^1.34.0"
	},
	"categories": [
		"Themes"
	],
	"keywords": [
		"coda",
		"panic",
		"warm",
		"dark theme",
		"syntax highlighting"
	],
	"contributes": {
		"themes": [
			{
				"id": "specials-board",
				"label": "Specials Board",
				"uiTheme": "vs-dark",
				"path": "./themes/specialsboard-flagship.json"
			},
			{
				"id": "specials-board-classic",
				"label": "Specials Board Classic",
				"uiTheme": "vs-dark",
				"path": "./themes/specialsboard-classic.json"
			},
			{
				"id": "specials-board-contrast",
				"label": "Specials Board Contrast",
				"uiTheme": "vs-dark",
				"path": "./themes/specialsboard-contrast.json"
			},
			{
				"id": "Specials Board ",
				"label": "Specials Board Legacy",
				"uiTheme": "vs-dark",
				"path": "./themes/specialsboard.json"
			}
		]
	},
	"galleryBanner": {
		"color": "#393939",
		"theme": "dark"
	},
	"bugs": {
		"url": "https://github.com/filipmares/vscode-specialsboard-theme/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/filipmares/vscode-specialsboard-theme.git"
	},
	"homepage": "https://github.com/filipmares/vscode-specialsboard-theme"
}
