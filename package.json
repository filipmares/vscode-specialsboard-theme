{
	"name": "theme-specialsboard",
	"displayName": "Specials Board",
	"description": "Coda heritage, warm charcoal and copper syntax. Four dark variants: modern Specials Board, Classic, measured Contrast, and deprecated VS Code Legacy.",
	"icon": "icon.png",
	"version": "3.5.0",
	"publisher": "filipmares",
	"scripts": {
		"generate": "node scripts/generate.mjs",
		"icon": "node scripts/icon.mjs",
		"check": "node scripts/generate.mjs --check && node scripts/icon.mjs --check",
		"accessibility:generate": "node scripts/accessibility.mjs --generate && node scripts/oh-my-posh-accessibility.mjs --generate",
		"accessibility": "node scripts/accessibility.mjs && node scripts/oh-my-posh-accessibility.mjs",
		"posh:smoke": "node scripts/oh-my-posh-smoke.mjs",
		"ports:validate": "npm run check && node scripts/validate-port-formats.mjs",
		"ports:package": "npm run check && pwsh -NoProfile -File scripts/package-ports.ps1",
		"test": "node --test",
		"vscode:prepublish": "npm run check && npm run accessibility",
		"package": "npm run check && npm run accessibility && npm test && vsce package --skip-license"
	},
	"devDependencies": {
		"@vscode/vsce": "3.9.2",
		"ajv": "8.20.0",
		"shiki": "4.4.3"
	},
	"engines": {
		"vscode": "^1.101.0"
	},
	"categories": [
		"Themes"
	],
	"keywords": [
		"coda",
		"warm",
		"dark theme",
		"syntax highlighting",
		"copper",
		"charcoal",
		"classic",
		"contrast",
		"semantic highlighting",
		"typescript",
		"python",
		"rust",
		"go"
	],
	"contributes": {
		"themes": [
			{
				"id": "specials-board",
				"label": "Specials Board",
				"uiTheme": "vs-dark",
				"path": "./themes/specialsboard-flagship.json"
			},
			{
				"id": "specials-board-classic",
				"label": "Specials Board Classic",
				"uiTheme": "vs-dark",
				"path": "./themes/specialsboard-classic.json"
			},
			{
				"id": "specials-board-contrast",
				"label": "Specials Board Contrast",
				"uiTheme": "vs-dark",
				"path": "./themes/specialsboard-contrast.json"
			},
			{
				"id": "specials-board-legacy",
				"label": "Specials Board VS Code Legacy [Deprecated]",
				"uiTheme": "vs-dark",
				"path": "./themes/specialsboard.json"
			}
		]
	},
	"galleryBanner": {
		"color": "#302e2c",
		"theme": "dark"
	},
	"bugs": {
		"url": "https://github.com/filipmares/vscode-specialsboard-theme/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/filipmares/vscode-specialsboard-theme.git"
	},
	"homepage": "https://github.com/filipmares/vscode-specialsboard-theme"
}
