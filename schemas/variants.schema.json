{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://specialsboard.local/schemas/variants",
  "type": "array",
  "minItems": 4,
  "items": {
    "type": "object",
    "required": ["key", "appearance", "id", "label", "vscodeId", "output", "inherits", "status"],
    "additionalProperties": false,
    "properties": {
      "key": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" },
      "appearance": { "enum": ["dark", "light"] },
      "id": { "type": "string", "pattern": "^specials-board(-[a-z]+)*$" },
      "label": { "type": "string", "minLength": 1 },
      "vscodeId": { "type": "string", "minLength": 1 },
      "output": { "type": "string", "pattern": "^specialsboard(-[a-z]+)*\\.json$" },
      "inherits": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" },
      "status": { "enum": ["foundation-preview", "restored", "accessibility-focused", "compatibility", "modern"] }
    }
  }
}
