  "name": "Specials Board Light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#704f00",
    "comment": {
      "foreground": "#4e555a",
      "italic": true
    },
    "decorator": "#a12320",
    "enum": "#704f00",
    "enumMember": "#164f9e",
    "event": "#874009",
    "function": "#a12320",
    "interface": "#704f00",
    "keyword": "#923b0d",
    "method": "#a12320",
    "namespace": "#704f00",
    "number": "#164f9e",
    "operator": "#222629",
    "parameter": "#45466c",
    "property": "#874009",
    "property.readonly": "#164f9e",
    "regexp": "#6930a3",
    "string": "#1f5d32",
    "struct": "#704f00",
    "type": "#704f00",
    "typeParameter": "#704f00",
    "variable": "#45466c",
    "variable.readonly": "#164f9e"
  },
  "tokenColors": [
    {
      "name": "Source and embedded expression defaults",
      "scope": [
        "source",
        "text",
        "meta.embedded",
        "meta.template.expression",
        "meta.interpolation"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#222629"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "block.scope",
        "function.brace"
      ],
      "settings": {
        "foreground": "#222629"
      }
    },
    {
      "name": "Variables and receivers",
      "scope": [
        "variable",
        "support.variable",
        "support.type.object"
      ],
      "settings": {
        "foreground": "#45466c"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "function.parameter"
      ],
      "settings": {
        "foreground": "#45466c"
      }
    },
    {
      "name": "Keywords and declarations",
      "scope": "keyword",
      "settings": {
        "foreground": "#923b0d"
      }
    },
    {
      "name": "Storage and declaration words, not declared type names",
      "scope": [
        "storage",
        "token.storage",
        "token.package.keyword"
      ],
      "settings": {
        "foreground": "#923b0d"
      }
    },
    {
      "name": "Symbolic operators",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#222629"
      }
    },
    {
      "name": "Word operators have keyword meaning",
      "scope": [
        "keyword.operator.word",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.expression",
        "keyword.operator.module",
        "keyword.operator.logical.python",
        "keyword.operator.logical.ruby"
      ],
      "settings": {
        "foreground": "#923b0d"
      }
    },
    {
      "name": "Types, classes, namespaces and components",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "support.module",
        "variable.other.class",
        "token.package"
      ],
      "settings": {
        "foreground": "#704f00"
      }
    },
    {
      "name": "Runtime objects are variables, not type annotations",
      "scope": [
        "support.type.object",
        "support.constant.math"
      ],
      "settings": {
        "foreground": "#45466c"
      }
    },
    {
      "name": "Functions and methods, including builtins and decorators",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "keyword.other.special-method",
        "support.token.decorator",
        "meta.function.decorator.identifier",
        "meta.function-call.generic.python"
      ],
      "settings": {
        "foreground": "#a12320"
      }
    },
    {
      "name": "Strings and their delimiters",
      "scope": [
        "string",
        "punctuation.definition.string",
        "punctuation.quasi.element",
        "keyword.other.template"
      ],
      "settings": {
        "foreground": "#1f5d32"
      }
    },
    {
      "name": "Constants and literal values",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "punctuation.definition.constant"
      ],
      "settings": {
        "foreground": "#164f9e"
      }
    },
    {
      "name": "Numbers and units",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#164f9e"
      }
    },
    {
      "name": "Tags and tag delimiters",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#704f00"
      }
    },
    {
      "name": "Attributes and property names, not values",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "support.type.vendored.property-name",
        "variable.other.property",
        "variable.other.object.property",
        "variable.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "meta.mapping.key",
        "meta.attribute.python"
      ],
      "settings": {
        "foreground": "#874009"
      }
    },
    {
      "name": "Quoted config keys and their punctuation",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.json punctuation",
        "meta.mapping.key string",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#874009"
      }
    },
    {
      "name": "CSS selectors identify elements, not attributes",
      "scope": [
        "meta.selector",
        "selector.sass",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#704f00"
      }
    },
    {
      "name": "CSS values and named colors are literals",
      "scope": [
        "support.constant.property-value",
        "support.constant.color",
        "support.constant.font-name"
      ],
      "settings": {
        "foreground": "#164f9e"
      }
    },
    {
      "name": "Regex body and operators stay purple, not string green",
      "scope": [
        "string.regexp",
        "string.regex",
        "string.regexp keyword",
        "string.regexp keyword.operator",
        "string.regexp variable",
        "string.regexp punctuation",
        "string.regexp punctuation.definition.string",
        "string.regexp constant",
        "string.regexp entity.name.tag",
        "string.regexp storage.type.string",
        "keyword.operator.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#6930a3"
      }
    },
    {
      "name": "Escapes and regex character classes",
      "scope": [
        "constant.character.escape",
        "constant.character.format",
        "constant.other.character-class.regexp",
        "string.regexp constant.character.escape",
        "string.regexp constant.other.character-class",
        "string.regexp constant.character.character-class",
        "string.regexp constant.other.character-class punctuation.definition.character-class",
        "support.other.escape.regexp",
        "support.other.escape.special.regexp",
        "constant.character.set.regexp",
        "constant.other.set.regexp"
      ],
      "settings": {
        "foreground": "#843187"
      }
    },
    {
      "name": "Entity references are constants, not regex escapes",
      "scope": [
        "constant.character.entity",
        "constant.character.entity punctuation.definition.entity"
      ],
      "settings": {
        "foreground": "#164f9e"
      }
    },
    {
      "name": "Interpolation expressions reset inherited string color",
      "scope": [
        "meta.template.expression",
        "meta.interpolation"
      ],
      "settings": {
        "foreground": "#222629"
      }
    },
    {
      "name": "Interpolation delimiters are neutral",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "keyword.other.substitution",
        "punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#222629"
      }
    },
    {
      "name": "Comments and documentation",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4e555a"
      }
    },
    {
      "name": "Comment links stay quiet and readable",
      "scope": [
        "comment markup.link",
        "comment string",
        "comment keyword",
        "comment variable",
        "comment entity",
        "comment punctuation"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4e555a"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#704f00"
      }
    },
    {
      "name": "Markup strong emphasis",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#222629"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#222629"
      }
    },
    {
      "name": "Nested strong emphasis",
      "scope": [
        "markup.bold markup.italic",
        "markup.italic markup.bold"
      ],
      "settings": {
        "fontStyle": "bold italic",
        "foreground": "#222629"
      }
    },
    {
      "name": "Markup inline code and untyped code blocks",
      "scope": [
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#1f5d32"
      }
    },
    {
      "name": "Fenced code uses its embedded language roles",
      "scope": "markup.fenced_code.block",
      "settings": {
        "fontStyle": "",
        "foreground": "#222629"
      }
    },
    {
      "name": "Markup link text",
      "scope": [
        "string.other.link.title",
        "string.other.link.description",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#222629"
      }
    },
    {
      "name": "Markup link destinations",
      "scope": "markup.underline.link",
      "settings": {
        "fontStyle": "underline",
        "foreground": "#164f9e"
      }
    },
    {
      "name": "Markup lists",
      "scope": [
        "punctuation.definition.list",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#923b0d"
      }
    },
    {
      "name": "Markup quotes and separators",
      "scope": [
        "markup.quote",
        "meta.separator"
      ],
      "settings": {
        "foreground": "#4e555a"
      }
    },
    {
      "name": "Deleted diff",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#a61421"
      }
    },
    {
      "name": "Inserted diff",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#1f5d32"
      }
    },
    {
      "name": "Changed diff",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#923b0d"
      }
    },
    {
      "name": "Diff headers",
      "scope": [
        "meta.diff.header",
        "punctuation.definition.from-file",
        "punctuation.definition.to-file"
      ],
      "settings": {
        "foreground": "#164f9e"
      }
    },
    {
      "name": "Debug messages",
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#4e555a"
      }
    },
    {
      "name": "Information messages",
      "scope": "token.info-token",
      "settings": {
        "foreground": "#164f9e"
      }
    },
    {
      "name": "Warning messages",
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#704f00"
      }
    },
    {
      "name": "Error messages",
      "scope": "token.error-token",
      "settings": {
        "foreground": "#a61421"
      }
    },
    {
      "name": "Invalid syntax always remains visible",
      "scope": "invalid",
      "settings": {
        "fontStyle": "underline",
        "foreground": "#a61421"
      }
    }
  ],
  "type": "light"
}
