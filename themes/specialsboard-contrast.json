  "name": "Specials Board Contrast",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#f1c782",
    "comment": {
      "foreground": "#b4a99d",
      "italic": true
    },
    "decorator": "#e88e75",
    "enum": "#f1c782",
    "enumMember": "#8aafcb",
    "event": "#d99c63",
    "function": "#e88e75",
    "interface": "#f1c782",
    "keyword": "#e6ae74",
    "method": "#e88e75",
    "namespace": "#f1c782",
    "number": "#8aafcb",
    "operator": "#e6e1dc",
    "parameter": "#cec8e8",
    "property": "#d99c63",
    "property.readonly": "#8aafcb",
    "regexp": "#b798e3",
    "string": "#b2c879",
    "struct": "#f1c782",
    "type": "#f1c782",
    "typeParameter": "#f1c782",
    "variable": "#cec8e8",
    "variable.readonly": "#8aafcb"
  },
  "tokenColors": [
    {
      "name": "Source and embedded expression defaults",
      "scope": [
        "source",
        "text",
        "meta.embedded",
        "meta.template.expression",
        "meta.interpolation"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "block.scope",
        "function.brace"
      ],
      "settings": {
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Variables and receivers",
      "scope": [
        "variable",
        "support.variable",
        "support.type.object"
      ],
      "settings": {
        "foreground": "#cec8e8"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "function.parameter"
      ],
      "settings": {
        "foreground": "#cec8e8"
      }
    },
    {
      "name": "Keywords and declarations",
      "scope": "keyword",
      "settings": {
        "foreground": "#e6ae74"
      }
    },
    {
      "name": "Storage and declaration words, not declared type names",
      "scope": [
        "storage",
        "token.storage",
        "token.package.keyword"
      ],
      "settings": {
        "foreground": "#e6ae74"
      }
    },
    {
      "name": "Symbolic operators",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Word operators have keyword meaning",
      "scope": [
        "keyword.operator.word",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.expression",
        "keyword.operator.module",
        "keyword.operator.logical.python",
        "keyword.operator.logical.ruby"
      ],
      "settings": {
        "foreground": "#e6ae74"
      }
    },
    {
      "name": "Types, classes, namespaces and components",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "support.module",
        "variable.other.class",
        "token.package"
      ],
      "settings": {
        "foreground": "#f1c782"
      }
    },
    {
      "name": "Runtime objects are variables, not type annotations",
      "scope": [
        "support.type.object",
        "support.constant.math"
      ],
      "settings": {
        "foreground": "#cec8e8"
      }
    },
    {
      "name": "Functions and methods, including builtins and decorators",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "keyword.other.special-method",
        "support.token.decorator",
        "meta.function.decorator.identifier",
        "meta.function-call.generic.python"
      ],
      "settings": {
        "foreground": "#e88e75"
      }
    },
    {
      "name": "Strings and their delimiters",
      "scope": [
        "string",
        "punctuation.definition.string",
        "punctuation.quasi.element",
        "keyword.other.template"
      ],
      "settings": {
        "foreground": "#b2c879"
      }
    },
    {
      "name": "Constants and literal values",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "punctuation.definition.constant"
      ],
      "settings": {
        "foreground": "#8aafcb"
      }
    },
    {
      "name": "Numbers and units",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#8aafcb"
      }
    },
    {
      "name": "Tags and tag delimiters",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#f1c782"
      }
    },
    {
      "name": "Attributes and property names, not values",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "support.type.vendored.property-name",
        "variable.other.property",
        "variable.other.object.property",
        "variable.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "meta.mapping.key",
        "meta.attribute.python"
      ],
      "settings": {
        "foreground": "#d99c63"
      }
    },
    {
      "name": "Quoted config keys and their punctuation",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.json punctuation",
        "meta.mapping.key string",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#d99c63"
      }
    },
    {
      "name": "CSS selectors identify elements, not attributes",
      "scope": [
        "meta.selector",
        "selector.sass",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#f1c782"
      }
    },
    {
      "name": "CSS values and named colors are literals",
      "scope": [
        "support.constant.property-value",
        "support.constant.color",
        "support.constant.font-name"
      ],
      "settings": {
        "foreground": "#8aafcb"
      }
    },
    {
      "name": "Regex body and operators stay purple, not string green",
      "scope": [
        "string.regexp",
        "string.regex",
        "string.regexp keyword",
        "string.regexp keyword.operator",
        "string.regexp variable",
        "string.regexp punctuation",
        "string.regexp punctuation.definition.string",
        "string.regexp constant",
        "string.regexp entity.name.tag",
        "string.regexp storage.type.string",
        "keyword.operator.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#b798e3"
      }
    },
    {
      "name": "Escapes and regex character classes",
      "scope": [
        "constant.character.escape",
        "constant.character.format",
        "constant.other.character-class.regexp",
        "string.regexp constant.character.escape",
        "string.regexp constant.other.character-class",
        "string.regexp constant.character.character-class",
        "string.regexp constant.other.character-class punctuation.definition.character-class",
        "support.other.escape.regexp",
        "support.other.escape.special.regexp",
        "constant.character.set.regexp",
        "constant.other.set.regexp"
      ],
      "settings": {
        "foreground": "#cfa9f0"
      }
    },
    {
      "name": "Entity references are constants, not regex escapes",
      "scope": [
        "constant.character.entity",
        "constant.character.entity punctuation.definition.entity"
      ],
      "settings": {
        "foreground": "#8aafcb"
      }
    },
    {
      "name": "Interpolation expressions reset inherited string color",
      "scope": [
        "meta.template.expression",
        "meta.interpolation"
      ],
      "settings": {
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Interpolation delimiters are neutral",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "keyword.other.substitution",
        "punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Comments and documentation",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#b4a99d"
      }
    },
    {
      "name": "Comment links stay quiet and readable",
      "scope": [
        "comment markup.link",
        "comment string",
        "comment keyword",
        "comment variable",
        "comment entity",
        "comment punctuation"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#b4a99d"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#f1c782"
      }
    },
    {
      "name": "Markup strong emphasis",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Nested strong emphasis",
      "scope": [
        "markup.bold markup.italic",
        "markup.italic markup.bold"
      ],
      "settings": {
        "fontStyle": "bold italic",
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Markup inline code and untyped code blocks",
      "scope": [
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#b2c879"
      }
    },
    {
      "name": "Fenced code uses its embedded language roles",
      "scope": "markup.fenced_code.block",
      "settings": {
        "fontStyle": "",
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Markup link text",
      "scope": [
        "string.other.link.title",
        "string.other.link.description",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Markup link destinations",
      "scope": "markup.underline.link",
      "settings": {
        "fontStyle": "underline",
        "foreground": "#8aafcb"
      }
    },
    {
      "name": "Markup lists",
      "scope": [
        "punctuation.definition.list",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#e6ae74"
      }
    },
    {
      "name": "Markup quotes and separators",
      "scope": [
        "markup.quote",
        "meta.separator"
      ],
      "settings": {
        "foreground": "#b4a99d"
      }
    },
    {
      "name": "Deleted diff",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#f08d82"
      }
    },
    {
      "name": "Inserted diff",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#b2c879"
      }
    },
    {
      "name": "Changed diff",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#e6ae74"
      }
    },
    {
      "name": "Diff headers",
      "scope": [
        "meta.diff.header",
        "punctuation.definition.from-file",
        "punctuation.definition.to-file"
      ],
      "settings": {
        "foreground": "#8aafcb"
      }
    },
    {
      "name": "Debug messages",
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#b4a99d"
      }
    },
    {
      "name": "Information messages",
      "scope": "token.info-token",
      "settings": {
        "foreground": "#8aafcb"
      }
    },
    {
      "name": "Warning messages",
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#f1c782"
      }
    },
    {
      "name": "Error messages",
      "scope": "token.error-token",
      "settings": {
        "foreground": "#f08d82"
      }
    },
    {
      "name": "Invalid syntax always remains visible",
      "scope": "invalid",
      "settings": {
        "fontStyle": "underline",
        "foreground": "#f08d82"
      }
    }
  ],
  "type": "dark"
}
