{
  "$schema": "vscode://schemas/color-theme",
  "author": "Filip Mares",
  "colors": {
    "activityBar.background": "#2e2d2d",
    "activityBarBadge.background": "#d0663a",
    "badge.background": "#d0663a",
    "editor.background": "#302e2c",
    "editor.foreground": "#e6e1dc",
    "editor.lineHighlightBackground": "#2e2d2d",
    "editor.selectionBackground": "#6c99bb33",
    "editorCursor.foreground": "#e6e1dc",
    "editorWhitespace.foreground": "#434343",
    "list.activeSelectionBackground": "#302e2c",
    "list.activeSelectionForeground": "#e6e1dc",
    "list.hoverBackground": "#676869",
    "list.inactiveSelectionBackground": "#676869",
    "sideBar.background": "#2e2d2d",
    "sideBarSectionHeader.background": "#2e2d2d",
    "statusBar.background": "#302e2c",
    "statusBar.debuggingBackground": "#302e2c",
    "statusBar.debuggingBorder": "#302e2c",
    "statusBar.debuggingForeground": "#e6e1dc",
    "statusBar.foreground": "#e6e1dc",
    "statusBar.noFolderBackground": "#302e2c",
    "statusBarItem.hoverBackground": "#676869",
    "statusBarItem.remoteBackground": "#5286b7",
    "statusBarItem.remoteForeground": "#e6e1dc",
    "tab.activeBackground": "#302e2c",
    "tab.activeForeground": "#e6e1dc",
    "tab.border": "#2e2d2d",
    "tab.hoverBackground": "#676869",
    "tab.inactiveBackground": "#2e2d2d",
    "tab.unfocusedHoverBackground": "#676869",
    "terminal.ansiBlack": "#2d3139",
    "terminal.ansiBlue": "#5286b7",
    "terminal.ansiBrightBlack": "#7f848e",
    "terminal.ansiBrightBlue": "#86a9c4",
    "terminal.ansiBrightCyan": "#86a9c4",
    "terminal.ansiBrightGreen": "#b9c87f",
    "terminal.ansiBrightMagenta": "#a97a8c",
    "terminal.ansiBrightRed": "#ac4639",
    "terminal.ansiBrightWhite": "#d9dbfc",
    "terminal.ansiBrightYellow": "#c4bc3c",
    "terminal.ansiCyan": "#86a9c4",
    "terminal.ansiGreen": "#b9c87f",
    "terminal.ansiMagenta": "#a97a8c",
    "terminal.ansiRed": "#ac4639",
    "terminal.ansiWhite": "#d9dbfc",
    "terminal.ansiYellow": "#c4bc3c",
    "terminal.foreground": "#d9dbfc"
  },
  "name": "Specials Board",
  "tokenColors": [
    {
      "name": "Source and embedded expression defaults",
      "scope": [
        "source",
        "text",
        "meta.embedded",
        "meta.template.expression",
        "meta.interpolation"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "block.scope",
        "function.brace"
      ],
      "settings": {
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Variables and receivers",
      "scope": [
        "variable",
        "support.variable",
        "support.type.object"
      ],
      "settings": {
        "foreground": "#cec8e8"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "function.parameter"
      ],
      "settings": {
        "foreground": "#cec8e8"
      }
    },
    {
      "name": "Keywords and declarations",
      "scope": "keyword",
      "settings": {
        "foreground": "#d99559"
      }
    },
    {
      "name": "Storage and declaration words, not declared type names",
      "scope": [
        "storage",
        "token.storage",
        "token.package.keyword"
      ],
      "settings": {
        "foreground": "#d99559"
      }
    },
    {
      "name": "Symbolic operators",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Word operators have keyword meaning",
      "scope": [
        "keyword.operator.word",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.expression",
        "keyword.operator.module",
        "keyword.operator.logical.python",
        "keyword.operator.logical.ruby"
      ],
      "settings": {
        "foreground": "#d99559"
      }
    },
    {
      "name": "Types, classes, namespaces and components",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "support.module",
        "variable.other.class",
        "token.package"
      ],
      "settings": {
        "foreground": "#efc17b"
      }
    },
    {
      "name": "Runtime objects are variables, not type annotations",
      "scope": [
        "support.type.object",
        "support.constant.math"
      ],
      "settings": {
        "foreground": "#cec8e8"
      }
    },
    {
      "name": "Functions and methods, including builtins and decorators",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "keyword.other.special-method",
        "support.token.decorator",
        "meta.function.decorator.identifier",
        "meta.function-call.generic.python"
      ],
      "settings": {
        "foreground": "#e08066"
      }
    },
    {
      "name": "Strings and their delimiters",
      "scope": [
        "string",
        "punctuation.definition.string",
        "punctuation.quasi.element",
        "keyword.other.template"
      ],
      "settings": {
        "foreground": "#b2c879"
      }
    },
    {
      "name": "Constants and literal values",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "punctuation.definition.constant"
      ],
      "settings": {
        "foreground": "#8aafcb"
      }
    },
    {
      "name": "Numbers and units",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#8aafcb"
      }
    },
    {
      "name": "Tags and tag delimiters",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#efc17b"
      }
    },
    {
      "name": "Attributes and property names, not values",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "support.type.vendored.property-name",
        "variable.other.property",
        "variable.other.object.property",
        "variable.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "meta.mapping.key",
        "meta.attribute.python"
      ],
      "settings": {
        "foreground": "#dfab73"
      }
    },
    {
      "name": "Quoted config keys and their punctuation",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.json punctuation",
        "meta.mapping.key string",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#dfab73"
      }
    },
    {
      "name": "CSS selectors identify elements, not attributes",
      "scope": [
        "meta.selector",
        "selector.sass",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#efc17b"
      }
    },
    {
      "name": "CSS values and named colors are literals",
      "scope": [
        "support.constant.property-value",
        "support.constant.color",
        "support.constant.font-name"
      ],
      "settings": {
        "foreground": "#8aafcb"
      }
    },
    {
      "name": "Regex body and operators stay purple, not string green",
      "scope": [
        "string.regexp",
        "string.regex",
        "string.regexp keyword",
        "string.regexp keyword.operator",
        "string.regexp variable",
        "string.regexp punctuation",
        "string.regexp punctuation.definition.string",
        "string.regexp constant",
        "string.regexp entity.name.tag",
        "string.regexp storage.type.string",
        "keyword.operator.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#b18adb"
      }
    },
    {
      "name": "Escapes and regex character classes",
      "scope": [
        "constant.character.escape",
        "constant.character.format",
        "constant.other.character-class.regexp",
        "string.regexp constant.character.escape",
        "string.regexp constant.other.character-class",
        "string.regexp constant.character.character-class",
        "string.regexp constant.other.character-class punctuation.definition.character-class",
        "support.other.escape.regexp",
        "support.other.escape.special.regexp",
        "constant.character.set.regexp",
        "constant.other.set.regexp"
      ],
      "settings": {
        "foreground": "#cca5ed"
      }
    },
    {
      "name": "Entity references are constants, not regex escapes",
      "scope": [
        "constant.character.entity",
        "constant.character.entity punctuation.definition.entity"
      ],
      "settings": {
        "foreground": "#8aafcb"
      }
    },
    {
      "name": "Interpolation expressions reset inherited string color",
      "scope": [
        "meta.template.expression",
        "meta.interpolation"
      ],
      "settings": {
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Interpolation delimiters are neutral",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "keyword.other.substitution",
        "punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Comments and documentation",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#a39a90"
      }
    },
    {
      "name": "Comment links stay quiet and readable",
      "scope": [
        "comment markup.link",
        "comment string",
        "comment keyword",
        "comment variable",
        "comment entity",
        "comment punctuation"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#a39a90"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#efc17b"
      }
    },
    {
      "name": "Markup strong emphasis",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Nested strong emphasis",
      "scope": [
        "markup.bold markup.italic",
        "markup.italic markup.bold"
      ],
      "settings": {
        "fontStyle": "bold italic",
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Markup inline code and untyped code blocks",
      "scope": [
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#b2c879"
      }
    },
    {
      "name": "Fenced code uses its embedded language roles",
      "scope": "markup.fenced_code.block",
      "settings": {
        "fontStyle": "",
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Markup link text",
      "scope": [
        "string.other.link.title",
        "string.other.link.description",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#e6e1dc"
      }
    },
    {
      "name": "Markup link destinations",
      "scope": "markup.underline.link",
      "settings": {
        "fontStyle": "underline",
        "foreground": "#8aafcb"
      }
    },
    {
      "name": "Markup lists",
      "scope": [
        "punctuation.definition.list",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#d99559"
      }
    },
    {
      "name": "Markup quotes and separators",
      "scope": [
        "markup.quote",
        "meta.separator"
      ],
      "settings": {
        "foreground": "#a39a90"
      }
    },
    {
      "name": "Deleted diff",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#ed746b"
      }
    },
    {
      "name": "Inserted diff",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#b2c879"
      }
    },
    {
      "name": "Changed diff",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#d99559"
      }
    },
    {
      "name": "Diff headers",
      "scope": [
        "meta.diff.header",
        "punctuation.definition.from-file",
        "punctuation.definition.to-file"
      ],
      "settings": {
        "foreground": "#8aafcb"
      }
    },
    {
      "name": "Debug messages",
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#a39a90"
      }
    },
    {
      "name": "Information messages",
      "scope": "token.info-token",
      "settings": {
        "foreground": "#8aafcb"
      }
    },
    {
      "name": "Warning messages",
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#efc17b"
      }
    },
    {
      "name": "Error messages",
      "scope": "token.error-token",
      "settings": {
        "foreground": "#ed746b"
      }
    },
    {
      "name": "Invalid syntax always remains visible",
      "scope": "invalid",
      "settings": {
        "fontStyle": "underline",
        "foreground": "#ed746b"
      }
    }
  ],
  "type": "dark"
}
