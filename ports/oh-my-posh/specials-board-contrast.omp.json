{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/fc19b6fccaac637600151d0c383cd86bc949f290/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "p:background",
          "foreground": "p:path",
          "options": {
            "style": "full"
          },
          "style": "plain",
          "template": " {{ .Path }}",
          "type": "path"
        },
        {
          "background": "p:background",
          "foreground": "p:git-clean",
          "foreground_templates": [
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:git-diverged{{ end }}",
            "{{ if .Working.Changed }}p:git-modified{{ end }}",
            "{{ if .Staging.Changed }}p:git-staged{{ end }}",
            "{{ if gt .Ahead 0 }}p:git-ahead{{ end }}",
            "{{ if gt .Behind 0 }}p:git-behind{{ end }}"
          ],
          "options": {
            "branch_icon": "",
            "cherry_pick_icon": "cherry-pick:",
            "commit_icon": "commit:",
            "merge_icon": "merge:",
            "native_status": false,
            "no_commits_icon": "new:",
            "rebase_icon": "rebase:",
            "revert_icon": "revert:",
            "tag_icon": "tag:"
          },
          "style": "plain",
          "template": " <p:separator>|</> git:{{ .HEAD }}{{ if not (or .Working.Changed .Staging.Changed) }} clean{{ end }}{{ if .Working.Changed }} modified:{{ .Working.String }}{{ end }}{{ if .Staging.Changed }} staged:{{ .Staging.String }}{{ end }}{{ if gt .Ahead 0 }} ahead:{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} behind:{{ .Behind }}{{ end }}{{ if and (gt .Ahead 0) (gt .Behind 0) }} diverged{{ end }}",
          "type": "git"
        },
        {
          "background": "p:background",
          "foreground": "p:duration",
          "options": {
            "style": "austin",
            "threshold": 500
          },
          "style": "plain",
          "template": " <p:separator>|</> time:{{ .FormattedMs }}",
          "type": "executiontime"
        },
        {
          "background": "p:background",
          "foreground": "p:success",
          "foreground_templates": [
            "{{ if ne .Code 0 }}p:failure{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "style": "plain",
          "template": " <p:separator>|</> {{ if ne .Code 0 }}exit:{{ .Code }}{{ else }}ok{{ end }} >",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "palette": {
    "background": "#181715",
    "duration": "#c2b7aa",
    "failure": "#f08d82",
    "git-ahead": "#8aafcb",
    "git-behind": "#f1c782",
    "git-clean": "#b2c879",
    "git-diverged": "#f08d82",
    "git-modified": "#f1c782",
    "git-staged": "#e6ae74",
    "path": "#e6e1dc",
    "separator": "#c2b7aa",
    "success": "#b2c879"
  },
  "version": 4
}
