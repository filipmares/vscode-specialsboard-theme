{
  "$description": "Portable component/state roles; no VS Code workbench IDs or TextMate scopes.",
  "$extensions": {
    "org.specialsboard.provenance": {
      "source": "phase1-role-extraction",
      "evidence": "Role extraction from themes/specialsboard.json at c188c33; scope order and assignments retained."
    }
  },
  "component": {
    "workbench": {
      "$extensions": { "org.specialsboard.provenance": { "source": "phase3-workbench", "evidence": "Three persistent planes: ambient chrome, navigation and existing variant canvas. Raised surfaces are transient overlays, not a fourth persistent plane." } },
      "ambient": { "$type": "color", "$value": "{semantic.workbench.ambient}" },
      "navigation": { "$type": "color", "$value": "{semantic.workbench.navigation}" },
      "canvas": { "$type": "color", "$value": "{semantic.surface.canvas}" },
      "raised": { "$type": "color", "$value": "{semantic.workbench.raised}" },
      "foreground": { "$type": "color", "$value": "{semantic.text.primary}" },
      "muted": { "$type": "color", "$value": "{semantic.workbench.muted}" },
      "disabled": { "$type": "color", "$value": "{semantic.workbench.disabled}" },
      "border": { "$type": "color", "$value": "{semantic.workbench.border}" },
      "guide": { "$type": "color", "$value": "{semantic.workbench.guide}" },
      "shadow": { "$type": "color", "$value": "{semantic.workbench.shadow}" },
      "clear": { "$type": "color", "$value": "{semantic.workbench.clear}" }
    },
    "interaction": {
      "$extensions": { "org.specialsboard.provenance": { "source": "phase3-workbench", "evidence": "Shared hover, active, unfocused-selected, focus and translucent editor overlay states across all modern surfaces." } },
      "hover": { "$type": "color", "$value": "{semantic.workbench.hover}" },
      "active": { "$type": "color", "$value": "{semantic.workbench.active}" },
      "inactive": { "$type": "color", "$value": "{semantic.workbench.inactive}" },
      "focus": { "$type": "color", "$value": "{semantic.workbench.accent}" },
      "selection": { "$type": "color", "$value": "{semantic.workbench.selection}" },
      "occurrence": { "$type": "color", "$value": "{semantic.workbench.occurrence}" },
      "find": { "$type": "color", "$value": "{semantic.workbench.find}" },
      "line": { "$type": "color", "$value": "{semantic.workbench.line}" },
      "scroll": { "$type": "color", "$value": "{semantic.workbench.scroll}" },
      "scroll-hover": { "$type": "color", "$value": "{semantic.workbench.scroll-hover}" },
      "scroll-active": { "$type": "color", "$value": "{semantic.workbench.scroll-active}" },
      "unnecessary": { "$type": "color", "$value": "{semantic.workbench.unnecessary}" }
    },
    "control": {
      "$extensions": { "org.specialsboard.provenance": { "source": "phase3-workbench", "evidence": "Forms share navigation fills; primary copper controls use dark text, secondary controls use warm white on muted surfaces." } },
      "background": { "$type": "color", "$value": "{component.workbench.navigation}" },
      "primary": { "$type": "color", "$value": "{semantic.workbench.accent}" },
      "primary-hover": { "$type": "color", "$value": "{semantic.workbench.accent-hover}" },
      "on-primary": { "$type": "color", "$value": "{component.workbench.ambient}" },
      "secondary": { "$type": "color", "$value": "{semantic.workbench.hover}" }
    },
    "feedback": {
      "$extensions": { "org.specialsboard.provenance": { "source": "phase3-workbench", "evidence": "Stable feedback roles independent of Classic syntax intensity; line/word overlays remain translucent while validation popups use opaque fills." } },
      "error": { "$type": "color", "$value": "{semantic.workbench.error}" },
      "warning": { "$type": "color", "$value": "{semantic.workbench.warning}" },
      "info": { "$type": "color", "$value": "{semantic.workbench.info}" },
      "success": { "$type": "color", "$value": "{semantic.workbench.success}" },
      "error-fill": { "$type": "color", "$value": "{semantic.workbench.error-fill}" },
      "warning-fill": { "$type": "color", "$value": "{semantic.workbench.warning-fill}" },
      "info-fill": { "$type": "color", "$value": "{semantic.workbench.info-fill}" },
      "warning-tint": { "$type": "color", "$value": "{semantic.workbench.warning-tint}" },
      "success-tint": { "$type": "color", "$value": "{semantic.workbench.success-tint}" },
      "success-strong": { "$type": "color", "$value": "{semantic.workbench.success-strong}" },
      "error-tint": { "$type": "color", "$value": "{semantic.workbench.error-tint}" },
      "error-strong": { "$type": "color", "$value": "{semantic.workbench.error-strong}" },
      "success-label": { "$type": "color", "$value": "{semantic.workbench.success-label}" },
      "error-label": { "$type": "color", "$value": "{semantic.workbench.error-label}" },
      "info-marker": { "$type": "color", "$value": "{semantic.workbench.info-marker}" },
      "warning-marker": { "$type": "color", "$value": "{semantic.workbench.warning-marker}" },
      "accent-marker": { "$type": "color", "$value": "{semantic.workbench.accent-marker}" },
      "muted-marker": { "$type": "color", "$value": "{semantic.workbench.muted-marker}" }
    },
    "bracket": {
      "$extensions": { "org.specialsboard.provenance": { "source": "phase3-workbench", "evidence": "A restrained repeating honey/lavender/blue triad uses existing Phase 2 families, with quiet inactive guides and no color-vision differentiation claim." } },
      "first": { "$type": "color", "$value": "{semantic.workbench.bracket-first}" },
      "second": { "$type": "color", "$value": "{semantic.workbench.bracket-second}" },
      "third": { "$type": "color", "$value": "{semantic.workbench.bracket-third}" }
    },
    "editor": {
      "background": {
        "$type": "color",
        "$value": "{semantic.surface.canvas}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{semantic.text.primary}"
      },
      "cursor": {
        "$type": "color",
        "$value": "{semantic.text.warm}"
      },
      "whitespace": {
        "$type": "color",
        "$value": "{semantic.text.invisible}"
      },
      "line-highlight": {
        "$type": "color",
        "$value": "{semantic.surface.panel}"
      },
      "selection": {
        "$type": "color",
        "$value": "{semantic.surface.selection}"
      }
    },
    "badge": {
      "background": {
        "$type": "color",
        "$value": "{semantic.accent.primary}"
      }
    },
    "navigation": {
      "background": {
        "$type": "color",
        "$value": "{semantic.surface.panel}"
      }
    },
    "tab": {
      "active-background": {
        "$type": "color",
        "$value": "{semantic.surface.canvas}"
      },
      "active-foreground": {
        "$type": "color",
        "$value": "{semantic.text.primary}"
      },
      "border": {
        "$type": "color",
        "$value": "{semantic.surface.panel}"
      },
      "hover-background": {
        "$type": "color",
        "$value": "{semantic.surface.hover}"
      },
      "inactive-background": {
        "$type": "color",
        "$value": "{semantic.surface.panel}"
      }
    },
    "sidebar": {
      "background": {
        "$type": "color",
        "$value": "{semantic.surface.panel}"
      }
    },
    "list": {
      "active-background": {
        "$type": "color",
        "$value": "{semantic.surface.canvas}"
      },
      "active-foreground": {
        "$type": "color",
        "$value": "{semantic.text.primary}"
      },
      "hover-background": {
        "$type": "color",
        "$value": "{semantic.surface.hover}"
      },
      "inactive-background": {
        "$type": "color",
        "$value": "{semantic.surface.hover}"
      }
    },
    "console": {
      "foreground": {
        "$type": "color",
        "$value": "{semantic.terminal.foreground}"
      }
    },
    "status": {
      "background": {
        "$type": "color",
        "$value": "{semantic.surface.canvas}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{semantic.text.warm}"
      },
      "debug-background": {
        "$type": "color",
        "$value": "{semantic.surface.canvas}"
      },
      "debug-border": {
        "$type": "color",
        "$value": "{semantic.surface.canvas}"
      },
      "debug-foreground": {
        "$type": "color",
        "$value": "{semantic.text.primary}"
      },
      "hover-background": {
        "$type": "color",
        "$value": "{semantic.surface.hover}"
      },
      "remote-background": {
        "$type": "color",
        "$value": "{semantic.accent.remote}"
      },
      "remote-foreground": {
        "$type": "color",
        "$value": "{semantic.text.warm}"
      }
    }
  }
}
